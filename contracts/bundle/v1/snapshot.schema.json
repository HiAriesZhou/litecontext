{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://litecontext.dev/contracts/bundle/v1/snapshot.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "projectId",
    "generation",
    "sources",
    "items"
  ],
  "properties": {
    "projectId": {
      "type": "string",
      "pattern": "^prj_[0-9a-f]{32}$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "sources": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^src_[0-9a-f]{32}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record",
          "active"
        ],
        "properties": {
          "record": {
            "$ref": "../../context-model/v1/source-record.schema.json"
          },
          "active": {
            "type": "boolean"
          }
        }
      }
    },
    "items": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^itm_[0-9a-f]{64}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "current",
          "versions"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "pattern": "^src_[0-9a-f]{32}$"
          },
          "current": {
            "anyOf": [
              {
                "const": ""
              },
              {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            ]
          },
          "visibility": {
            "enum": [
              "private",
              "team",
              "public"
            ]
          },
          "versions": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "additionalProperties": {
              "$ref": "../../context-model/v1/context-item.schema.json"
            }
          }
        }
      }
    }
  }
}
