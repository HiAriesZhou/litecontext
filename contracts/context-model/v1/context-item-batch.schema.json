{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://litecontext.dev/contracts/context-model/v1/context-item-batch.schema.json",
  "title": "LiteContext ContextItem Batch v1",
  "description": "A bounded source-scoped producer mutation batch. Authentication and source ownership are outside this portable body; the runtime validates that every item belongs to the authenticated source.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mode", "items", "deletions"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "mode": { "enum": ["incremental", "snapshot"] },
    "items": { "type": "array", "minItems": 0, "maxItems": 500, "items": { "$ref": "context-item.schema.json" } },
    "deletions": { "type": "array", "minItems": 0, "maxItems": 500, "items": { "type": "string", "minLength": 1, "maxLength": 512 } }
  }
}
