{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://litecontext.dev/contracts/context-model/v1/source-record.schema.json",
  "title": "LiteContext SourceRecord",
  "description": "Canonical portable source identity. Operational health, local paths, credentials, cursors, and watchers are device-local runtime state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "type", "name", "createdAt", "updatedAt", "recordRevision", "canonicalRevision"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^src_[0-9a-f]{32}$" },
    "type": { "type": "string", "minLength": 1, "maxLength": 128 },
    "name": { "type": "string", "minLength": 1, "maxLength": 512 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "recordRevision": { "type": "integer", "minimum": 0 },
    "canonicalRevision": { "type": "integer", "minimum": 0 },
    "extensions": { "type": "object", "maxProperties": 32, "additionalProperties": true }
  }
}
