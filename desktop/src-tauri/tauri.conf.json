{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LiteContext",
  "version": "0.0.0",
  "identifier": "dev.litecontext.workbench",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LiteContext",
        "width": 1080,
        "height": 740,
        "minWidth": 820,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "externalBin": ["binaries/lc"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
